{
  "name": "@hilbras/omnicloud-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor shells for the OmniCloud iOS and Android apps.",
  "scripts": {
    "build:web": "pnpm --filter @omnicloud/web build",
    "sync": "pnpm build:web && cap sync",
    "sync:android": "pnpm build:web && cap sync android",
    "sync:ios": "pnpm build:web && cap sync ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}

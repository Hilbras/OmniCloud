{
  "name": "@hilbras/omnicloud-desktop",
  "version": "0.5.0",
  "private": false,
  "description": "OmniCloud desktop app — self-hosted cloud storage powered by your Telegram account.",
  "license": "MIT",
  "author": "Hilbras Team <contact@hilbras.com>",
  "type": "module",
  "main": "./dist/main/main.js",
  "homepage": "https://omnicloud.hilbras.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hilbras/OmniCloud.git",
    "directory": "apps/desktop"
  },
  "keywords": [
    "electron",
    "telegram",
    "cloud-storage",
    "self-hosted",
    "desktop-app"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "pnpm build:web && pnpm build:server && pnpm build:electron && electron-builder --linux deb AppImage",
    "build:web": "pnpm --filter @omnicloud/web build",
    "build:server": "pnpm --filter @hilbras/omnicloud bundle:server",
    "build:electron": "electron-vite build",
    "prepublishOnly": "pnpm build:web && pnpm build:server && pnpm build:electron",
    "postinstall": "electron-builder install-app-deps"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "build",
    "server",
    "web"
  ],
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "typescript": "^5.6.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.hilbras.omnicloud",
    "productName": "omnicloud",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "server/**/*",
      "web/**/*"
    ],
    "extraResources": [
      {
        "from": "../../packages/sdk/server",
        "to": "server"
      },
      {
        "from": "../../apps/web/dist",
        "to": "web"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "AppImage",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "Network",
      "icon": "build/icon.png"
    },
    "deb": {
      "depends": [
        "gconf2",
        "gconf-service",
        "libnotify4",
        "libappindicator1",
        "libxtst6",
        "libnss3",
        "libxss1",
        "libasound2"
      ]
    }
  }
}

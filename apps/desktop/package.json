{
  "name": "@hilbras/omnicloud-desktop",
  "version": "0.5.0",
  "private": true,
  "description": "OmniCloud desktop app \u2014 self-hosted cloud storage powered by your Telegram account.",
  "license": "MIT",
  "author": "Hilbras Team <contact@hilbras.com>",
  "type": "module",
  "main": "./out/main/main.js",
  "homepage": "https://omnicloud.hilbras.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hilbras/OmniCloud.git",
    "directory": "apps/desktop"
  },
  "keywords": [
    "electron",
    "telegram",
    "cloud-storage",
    "self-hosted",
    "desktop-app"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "dist": "pnpm build:web && pnpm build:server && pnpm copy:node_modules && pnpm build:electron && electron-builder --publish never",
    "build:web": "pnpm --filter @omnicloud/web build",
    "build:server": "pnpm --filter @hilbras/omnicloud bundle:server",
    "build:electron": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "copy:node_modules": "node copy-node-modules.mjs",
    "test": "vitest run"
  },
  "files": [
    "out",
    "build"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^35.7.5",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "com.hilbras.omnicloud",
    "productName": "OmniCloud",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map"
    ],
    "extraResources": [
      {
        "from": "../../packages/sdk/server",
        "to": "server"
      },
      {
        "from": "../../apps/web/dist",
        "to": "web"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icons",
      "executableName": "omnicloud"
    },
    "deb": {
      "depends": [
        "libasound2 | libasound2t64",
        "libatk1.0-0 | libatk1.0-0t64",
        "libatk-bridge2.0-0 | libatk-bridge2.0-0t64",
        "libcups2 | libcups2t64",
        "libdrm2",
        "libgbm1",
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libx11-xcb1",
        "libxcb1",
        "libxcomposite1",
        "libxdamage1",
        "libxrandr2",
        "libxss1",
        "libxtst6"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "Hilbras",
      "repo": "OmniCloud"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
